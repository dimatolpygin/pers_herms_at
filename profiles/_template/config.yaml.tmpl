# СГЕНЕРИРОВАНО scripts/profile_forge.py из profiles/_template/config.yaml.tmpl
# и profiles/registry.yaml. Руками не править — менять реестр и пересобирать.
#
# Внимание при `hermes profile update`: config.yaml принадлежит дистрибутиву,
# но на обновлении СОХРАНЯЕТСЯ (чтобы не затирать ручные настройки клиента).
# Чтобы перекатить и его — `hermes profile update <имя> --force-config`.

model:
  default: {{MODEL}}
  provider: {{PROVIDER}}

agent:
  # 80, а не 30. Проверено на проде: при 30 профиль СДЕЛАЛ документ и не успел
  # закрыть карточку — «Iteration budget exhausted (30/30)» -> timed_out ->
  # ретрай уже сделанной работы. Время ограничивается `max_runtime` задачи.
  max_turns: {{MAX_TURNS}}
  reasoning_effort: {{REASONING_EFFORT}}

terminal:
  backend: local
  timeout: 120
  # Форма важна: hermes читает этот ключ как СТРОКУ с JSON внутри.
  env_passthrough: '{{ENV_PASSTHROUGH}}'

memory:
  memory_enabled: {{MEMORY_ENABLED}}
  user_profile_enabled: {{USER_PROFILE_ENABLED}}
  memory_char_limit: {{MEMORY_CHAR_LIMIT}}
  provider: {{MEMORY_PROVIDER}}

# Это НЕ критик. `delegation.*` — про дочерние вызовы `delegate_task` внутри
# профиля (agent/iteration_budget.py, agent/delegation_context.py). Критик
# профиля живёт в SOUL.md и вызывается самим профилем как отдельная модель.
# Путать их нельзя: подменишь здесь — тихо подорожают субагенты, а критик
# останется прежним.
delegation:
  model: {{SUBAGENT_MODEL}}
  provider: {{PROVIDER}}
  max_iterations: 30

compression:
  enabled: {{COMPRESSION_ENABLED}}
  threshold: {{COMPRESSION_THRESHOLD}}
  target_ratio: {{COMPRESSION_TARGET_RATIO}}

display:
  language: ru
  show_reasoning: false
  streaming: true

timezone: {{TIMEZONE}}
