# .env профиля docs — ОБРАЗЕЦ. Реальный файл живёт только на сервере
# (/root/.hermes/profiles/docs/.env, режим 600) и в git не попадает.
#
# ⚠️ КАК ЕСТЬ НА ПРОДЕ (2026-08-27): .env профиля — побайтовая копия .env Геры,
# md5 совпадает. То есть профиль документов носит с собой токен Telegram-бота,
# OPENROUTER_MANAGEMENT_KEY (им можно выпускать новые API-ключи), FAL_ADMIN_KEY
# и два почтовых пароля — всё это ему не нужно.
#
# Почему не сузили сейчас: два навыка самого профиля сломаются —
# `balance` читает OPENROUTER_MANAGEMENT_KEY и FAL_ADMIN_KEY, `s3-upload` читает S3_*.
# Сужение .env — это работа по позиции «приватность на уровне профиля», которая в
# оплаченный объём пилота не входит (см. CLAUDE.md). Под профиль Health она станет
# обязательной: там в облако поедут медданные.
#
# Ниже — полный список переменных, которые профиль получает сегодня.
# Помечено, что ему действительно нужно.

# ─── Нужно профилю docs ───
OPENROUTER_API_KEY=            # инференс, биллинг на клиента
GOOGLE_SERVICE_ACCOUNT_FILE=   # путь к ключу сервисного аккаунта
GOOGLE_CALENDAR_ID=
S3_ENDPOINT=                   # s3-upload: отдать готовый .docx ссылкой
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=
OPENROUTER_MANAGEMENT_KEY=     # навык balance
FAL_ADMIN_KEY=                 # навык balance

# ─── Профилю docs НЕ нужно, но лежит (наследство копии) ───
TELEGRAM_BOT_TOKEN=            # профиль не бот, точка входа одна — Гера
TELEGRAM_ALLOWED_USERS=
TELEGRAM_HOME_CHANNEL=
TAVILY_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
GROQ_API_KEY=
KIE_AI_API_KEY=
CONTENT_DB_SCHEMA=
CONTENT_DB_TABLE=
CONTENT_PSQL_COMMAND=
POSTMYPOST_TOKEN=
POSTMYPOST_PROJECT_ID=
FAL_KEY=
SUPERMEMORY_API_KEY=
YANDEX_SEARCH_API_KEY=
YANDEX_FOLDER_ID=
GMAIL_APP_PASSWORD=
LOVA_EMAIL_PASSWORD=
WEB_TOOLS_DEBUG=
VISION_TOOLS_DEBUG=
